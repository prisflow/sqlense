{
  "name": "sqlense-vscode",
  "displayName": "SQLense",
  "description": "数据库实验课堂学生行为追踪与远程协助",
  "version": "0.1.0",
  "private": true,
  "publisher": "sqlense",
  "engines": {
    "vscode": "^1.85.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:sql",
    "onCommand:sqlense.connect",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlense.connect",
        "title": "SQLense: 连接课堂"
      },
      {
        "command": "sqlense.status",
        "title": "SQLense: 查看状态"
      }
    ],
    "configuration": {
      "title": "SQLense",
      "properties": {
        "sqlense.wsServer": {
          "type": "string",
          "default": "",
          "description": "WebSocket 服务器地址"
        },
        "sqlense.studentId": {
          "type": "string",
          "default": "",
          "description": "学生 ID"
        },
        "sqlense.studentName": {
          "type": "string",
          "default": "",
          "description": "学生姓名"
        }
      }
    }
  }
}
